# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / PUBLIC_APP_URL: Canonical public origin for OAuth & CORS
APP_URL="MY_APP_URL"
PUBLIC_APP_URL=""

# Server Session & Integrity Secrets (REQUIRED >= 32 random bytes in production; no defaults allowed)
TAMWEEN_SESSION_SECRET=""
TAMWEEN_DB_HMAC_SECRET=""

# Comma-separated trusted origins & frame-ancestors
ALLOWED_ORIGINS=""
ALLOWED_FRAME_ANCESTORS=""

# First-boot admin & vault initialization credentials in production (never reuse dev defaults)
INITIAL_ADMIN_PASSWORD=""
INITIAL_VAULT_PASSCODE=""

# PostgreSQL / Supabase Connection Strings (server-side only; zero secrets in VITE_*)
DATABASE_URL=""
SUPABASE_DB_URL=""
VITE_SUPABASE_URL="https://xyzcompany.supabase.co"
VITE_SUPABASE_ANON_KEY="REPLACE_WITH_SUPABASE_ANON_KEY"
